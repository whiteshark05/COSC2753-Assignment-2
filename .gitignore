# Ignore everything in data/ by default
data/*

# Un-ignore the directories so Git can traverse them
!data/raw/
!data/processed/

# Ignore contents of data/raw, but keep its .gitkeep
data/raw/*
!data/raw/.gitkeep

# Keep data/processed tracked (remove data/processed/* and its .gitkeep rule)

# System and editor files
__MACOSX/
.vscode/
/.venv

# Task 4 (visual search) -- local, regenerable or oversized artifacts.
# NOTE: git has no trailing-comment syntax; every comment here is on its own line.

# 20 ablation checkpoints, ~900MB. The per-rung result JSONs and progress logs in
# experiments/log/ are tracked instead.
experiments/*.pt

# Raw stdout from the ladder: tqdm progress spam, megabytes per rung. The useful record
# is experiments/log/progress_<tag>.log and result_<tag>.json, both tracked.
experiments/log/out_*.log
experiments/log/ladder_progress.log
experiments/log/notebook_run.log
__pycache__/

# Byte-identical duplicate of outputs/task4_models/task4_gallery_embeddings.npy
outputs/task4_deployment_embeddings.npy

# Local notebook backups
notebooks/*.ipynb.bak
notebooks/*.ipynb.executed_backup
notebooks/COSC2753_A2_Task4_UPLOAD_NOW.ipynb
